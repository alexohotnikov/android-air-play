+/* playlistInsert: the client queues its next video and expects the receiver to start it, with no POST /play
+   (VK Video switches videos this way). Plays a plain http(s) Content-Location as http_handler_play does;
+   other items (such as YouTube's HLS) are only logged. */
+static void
+start_inserted_video(raop_t *raop, plist_t item, const char *apple_session_id) {
+    char *uuid = NULL;
+    char *location = NULL;
+    double start = 0.0;
+    plist_t node = plist_dict_get_item(item, "uuid");
+    if (PLIST_IS_STRING(node)) plist_get_string_val(node, &uuid);
+    node = plist_dict_get_item(item, "Content-Location");
+    if (PLIST_IS_STRING(node)) plist_get_string_val(node, &location);
+    node = plist_dict_get_item(item, "Start-Position-Seconds");
+    if (PLIST_IS_REAL(node)) plist_get_real_val(node, &start);
+    if (!uuid || !location || !apple_session_id
+        || (strncmp(location, "http://", strlen("http://")) && strncmp(location, "https://", strlen("https://")))) {
+        char keys[256] = {0};
+        plist_dict_iter iter = NULL;
+        plist_dict_new_iter(item, &iter);
+        char *key = NULL;
+        plist_t val = NULL;
+        while (iter) {
+            plist_dict_next_item(item, iter, &key, &val);
+            if (!key) break;
+            if (strlen(keys) + strlen(key) + 2 < sizeof(keys)) {
+                strcat(keys, key);
+                strcat(keys, " ");
+            }
+            plist_mem_free(key);
+            key = NULL;
+        }
+        free(iter);
+        logger_log(raop->logger, LOGGER_INFO, "playlistInsert: item not played (keys: %s)", keys);
+        goto done;
+    }
+    int id = get_playlist_by_uuid(raop, uuid);
+    if (id >= 0) {
+        raop_destroy_airplay_video(raop, id);
+    }
+    id = -1;
+    for (int i = 0; i < MAX_AIRPLAY_VIDEO; i++) {
+        if (!raop->airplay_video[i]) {
+            id = i;
+            break;
+        }
+    }
+    if (id < 0) {
+        /* no free slot: reuse the one after the current video, as http_handler_play keeps one free */
+        id = (raop->current_video + 1 + MAX_AIRPLAY_VIDEO) % MAX_AIRPLAY_VIDEO;
+        raop_destroy_airplay_video(raop, id);
+    }
+    raop->airplay_video[id] = airplay_video_init(raop, raop->port, raop->lang, raop->lang_subtitles,
+                                                 raop->lang_system);
+    airplay_video_t *video = raop->airplay_video[id];
+    if (!video) {
+        goto done;
+    }
+    raop->current_video = id;
+    set_apple_session_id(video, apple_session_id, strlen(apple_session_id));
+    set_playback_uuid(video, uuid, strlen(uuid));
+    set_start_position_seconds(video, (float) start);
+    set_playback_location(video, location, strlen(location));
+    logger_log(raop->logger, LOGGER_INFO, "playlistInsert: playing the inserted video from %.1f s", start);
+    raop->callbacks.on_video_play(raop->callbacks.cls, get_playback_location(video), (float) start);
+ done:
+    plist_mem_free(uuid);
+    plist_mem_free(location);
+}
